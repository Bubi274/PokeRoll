{
  "name": "pokeroll",
  "productName": "PokeRoll",
  "version": "1.1.2",
  "description": "CS2-style Pokémon case opening",
  "author": "Bubi",
  "private": true,
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "images": "node scripts/build-images.js",
    "test": "node tests/run.js",
    "dist": "electron-builder --win --x64 --publish never",
    "dist:linux": "electron-builder --linux --x64 --publish never",
    "release": "node scripts/release.js"
  },
  "build": {
    "appId": "com.bubi.pokeroll",
    "productName": "PokeRoll",
    "files": [
      "main.js",
      "preload.js",
      "index.html",
      "style.css",
      "app.js",
      "data.js",
      "spawns.js",
      "special.js",
      "images/**",
      "fonts/**",
      "build/icon.png"
    ],
    "directories": {
      "output": "dist"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "Bubi274",
        "repo": "PokeRoll",
        "releaseType": "release"
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "deleteAppDataOnUninstall": false,
      "artifactName": "PokeRoll-Setup-${version}.${ext}"
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "icon": "build/icon.png",
      "category": "Game",
      "synopsis": "CS2-style Pokémon case opening",
      "maintainer": "Bubi",
      "artifactName": "PokeRoll-${version}-linux-${arch}.${ext}"
    }
  },
  "devDependencies": {
    "electron": "^44.9.3",
    "electron-builder": "^26.18.0",
    "sharp": "^0.35.5"
  },
  "dependencies": {
    "electron-updater": "^6.8.12"
  }
}
